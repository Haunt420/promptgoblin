name: Build Android APK
on:
  push:
    branches: [ main, master ]
    tags: [ 'v*' ]
  workflow_dispatch:
jobs:
  build:
    name: Build & Package Android APK
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.2.1
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
      - run: npm install
      - run: node scripts/generate-icons.js
      - run: |
          cd android
          gradle wrapper --gradle-version 8.2.1 --distribution-type bin
          chmod +x gradlew
      - run: npx cap sync android
      - run: |
          cd android
          ./gradlew assembleDebug --no-daemon --stacktrace
      - run: |
          mkdir -p build-output
          cp android/app/build/outputs/apk/debug/app-debug.apk build-output/kenzen-cockpit-perchance.apk
      - uses: actions/upload-artifact@v4
        with:
          name: kenzen-cockpit-perchance-apk
          path: build-output/kenzen-cockpit-perchance.apk
          retention-days: 30
      - if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: build-output/kenzen-cockpit-perchance.apk
          name: Release ${{ github.ref_name }}
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
